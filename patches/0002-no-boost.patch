 #include "Global.h"
 #include "InputSource.h"
 #include "Vector.h"
-#include <boost/circular_buffer.hpp>
+#include <deque>
+
+// The few parts of boost::circular_buffer the bots use: a fixed number of
+// places, the oldest dropped when a new one is pushed, read by index from
+// the oldest
+template<typename T>
+class BotRingBuffer
+{
+public:
+	BotRingBuffer() : mCapacity(0) {}
+	void set_capacity(std::size_t capacity)
+	{
+		mCapacity = capacity;
+		while (mItems.size() > mCapacity)
+			mItems.pop_front();
+	}
+	void push_back(const T& item)
+	{
+		if (mCapacity == 0)
+			return;
+		if (mItems.size() == mCapacity)
+			mItems.pop_front();
+		mItems.push_back(item);
+	}
+	const T& operator[](std::size_t index) const
+	{
+		return mItems[index];
+	}
+private:
+	std::size_t mCapacity;
+	std::deque<T> mItems;
+};
 
