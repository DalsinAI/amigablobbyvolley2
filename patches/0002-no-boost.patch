 #include <sstream>
-#include <boost/crc.hpp>
+
+// CRC-32 as boost::crc_32_type computes it (polynomial 0x04C11DB7,
+// reflected, initial and final value 0xFFFFFFFF), so replays keep the
+// checksum they had with Boost
+namespace
+{
+	class ReplayCrc32
+	{
+	public:
+		ReplayCrc32() : mCrc(0xFFFFFFFF) {}
+		void operator()(unsigned char byte)
+		{
+			mCrc ^= byte;
+			for (int bit = 0; bit < 8; ++bit)
+				mCrc = (mCrc >> 1) ^ (0xEDB88320 & (0 - (mCrc & 1)));
+		}
+		void process_bytes(const void* data, std::size_t length)
+		{
+			const unsigned char* bytes = (const unsigned char*)data;
+			for (std::size_t i = 0; i < length; ++i)
+				(*this)(bytes[i]);
+		}
+		uint32_t checksum() const
+		{
+			return mCrc ^ 0xFFFFFFFF;
+		}
+	private:
+		uint32_t mCrc;
+	};
+}
