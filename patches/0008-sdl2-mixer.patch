-Sound* SoundManager::loadSound(const std::string& filename)
+// the mixer's own sound channels: more than the game ever plays at once
+static const int MIX_CHANNELS_USED = 16;
+
+#if defined(__amigaos__)
+// the mixer's buffers, counted in its post-mix hook (the audio task):
+// how many, how many came more than half a buffer late, the longest gap
+static SDL_atomic_t sBuffers;
+static SDL_atomic_t sLate;
+static SDL_atomic_t sLongestGap;
+static SDL_atomic_t sStarted;
+static Uint32 sLastBuffer = 0;
+static Uint32 sBufferTicks = 0;
+
+static void countBuffer(void*, Uint8*, int)
+{
+	Uint32 now = SDL_GetTicks();
+	if (sLastBuffer != 0)
+	{
+		int gap = int(now - sLastBuffer);
+		if (gap > int(sBufferTicks + sBufferTicks / 2))
+			SDL_AtomicAdd(&sLate, 1);
+		if (gap > SDL_AtomicGet(&sLongestGap))
+			SDL_AtomicSet(&sLongestGap, gap);
+	}
+	sLastBuffer = now;
+	SDL_AtomicAdd(&sBuffers, 1);
+}
+
+void SoundManager::logBuffers()
+{
+	if (!mInitialised)
+		return;
+	int buffers = SDL_AtomicSet(&sBuffers, 0);
+	int late = SDL_AtomicSet(&sLate, 0);
+	int longest = SDL_AtomicSet(&sLongestGap, 0);
+	int started = SDL_AtomicSet(&sStarted, 0);
+	printf("audio %d buffers, %d late, longest gap %d ms, %d sounds started\n",
+		buffers, late, longest, started);
+	fflush(stdout);
+}
+#endif
