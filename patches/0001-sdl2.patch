+/*=============================================================================
+Blobby Volley 2
+blobby_sdl2.h: the SDL 1.2 calls Blobby Volley 2 makes, on SDL 2
+Copyright (C) 2026 AmiCradle Team
+
+This program is free software; you can redistribute it and/or modify
+it under the terms of the GNU General Public License as published by
+the Free Software Foundation; either version 2 of the License, or
+(at your option) any later version.
+
+This program is distributed in the hope that it will be useful,
+but WITHOUT ANY WARRANTY; without even the implied warranty of
+MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+GNU General Public License for more details.
+=============================================================================*/
+
+/*
+ * Blobby Volley 2's SDL renderer draws with surfaces and blits only, so
+ * SDL 2 takes most of it as it is. What SDL 2 dropped is here, with the
+ * meaning SDL 1.2 gave it:
+ *
+ *  - the surface flags SDL_SRCCOLORKEY and SDL_SRCALPHA;
+ *  - SDL_SetAlpha(): a per-surface alpha, and blending;
+ *  - SDL_DisplayFormat() and SDL_DisplayFormatAlpha(), which need the
+ *    display's pixel format (the renderer hands the window over with
+ *    blobby_sdl2_set_window()). SDL_DisplayFormatAlpha() turns the
+ *    colour key into see-through pixels and gives every other pixel the
+ *    surface's own alpha, as SDL 1.2 did;
+ *  - the per-surface alpha SDL 1.2 kept in format->alpha;
+ *  - SDL_WM_SetCaption(), SDL_GetKeyState() and the old key type.
+ *
+ * The window itself (creation, the window surface, updates) is in
+ * RenderManagerSDL.cpp.
+ */
+
+#pragma once
+
+#include <SDL.h>
+
+/* SDL 1.2's surface flags, as Blobby passes them */
+#ifndef SDL_SRCCOLORKEY
+#define SDL_SRCCOLORKEY 0x00001000
+#endif
+#ifndef SDL_SRCALPHA
+#define SDL_SRCALPHA 0x00010000
+#endif
+#ifndef SDL_HWSURFACE
+#define SDL_HWSURFACE 0x00000001
+#endif
+
+typedef SDL_Keycode SDLKey;
+
+/* 32-bit RGB surfaces whose bytes are R, G, B, unused in memory, so an
+   SDL_Color can be laid over each pixel on either byte order */
+#if SDL_BYTEORDER == SDL_BIG_ENDIAN
+#define BLOBBY_RMASK 0xFF000000
+#define BLOBBY_GMASK 0x00FF0000
+#define BLOBBY_BMASK 0x0000FF00
+#else
+#define BLOBBY_RMASK 0x000000FF
+#define BLOBBY_GMASK 0x0000FF00
+#define BLOBBY_BMASK 0x00FF0000
+#endif
+
+/* The window the game shows; NULL while there is none */
+extern SDL_Window* blobby_sdl2_window;
+void blobby_sdl2_set_window(SDL_Window* window);
+
+/* SDL 1.2 SDL_SetColorKey(): flags SDL_SRCCOLORKEY and SDL_RLEACCEL */
+static inline int blobby_SetColorKey(SDL_Surface* s, Uint32 flags, Uint32 key)
+{
+	if (!s)
+		return -1;
+	SDL_SetSurfaceRLE(s, (flags & SDL_RLEACCEL) ? 1 : 0);
+	return SDL_SetColorKey(s, (flags & SDL_SRCCOLORKEY) ? SDL_TRUE : SDL_FALSE, key);
+}
+
+/* SDL 1.2 SDL_SetAlpha(): with SDL_SRCALPHA, blend; a surface with an
+   alpha channel by that channel alone (SDL 1.2 ignored the surface
+   alpha then), one without by the surface alpha. The value is kept as
+   the surface's alpha modulation either way, as format->alpha kept it. */
+static inline int blobby_SetAlpha(SDL_Surface* s, Uint32 flags, Uint8 alpha)
+{
+	if (!s)
+		return -1;
+	if (!(flags & SDL_SRCALPHA))
+	{
+		SDL_SetSurfaceAlphaMod(s, SDL_ALPHA_OPAQUE);
+		return SDL_SetSurfaceBlendMode(s, SDL_BLENDMODE_NONE);
+	}
+	SDL_SetSurfaceAlphaMod(s, s->format->Amask ? SDL_ALPHA_OPAQUE : alpha);
+	return SDL_SetSurfaceBlendMode(s, SDL_BLENDMODE_BLEND);
+}
+
+/* SDL 1.2's surface->format->alpha */
+static inline Uint8 blobby_GetAlpha(SDL_Surface* s)
+{
+	Uint8 alpha = SDL_ALPHA_OPAQUE;
+	if (s)
+		SDL_GetSurfaceAlphaMod(s, &alpha);
+	return alpha;
+}
+
+/* SDL 1.2 SDL_DisplayFormat() and SDL_DisplayFormatAlpha() */
+SDL_Surface* blobby_DisplayFormat(SDL_Surface* s);
+SDL_Surface* blobby_DisplayFormatAlpha(SDL_Surface* s);
+
+/* SDL 1.2 SDL_GetKeyState(): the state by key, not by scan code */
+static inline bool blobby_KeyDown(SDLKey key)
+{
+	const Uint8* state = SDL_GetKeyboardState(0);
+	SDL_Scancode code = SDL_GetScancodeFromKey(key);
+	return code != SDL_SCANCODE_UNKNOWN && state[code];
+}
+
+static inline void blobby_WM_SetCaption(const char* title)
+{
+	if (blobby_sdl2_window)
+		SDL_SetWindowTitle(blobby_sdl2_window, title);
+}
+
+#undef SDL_SetColorKey
+#define SDL_SetColorKey blobby_SetColorKey
+#define SDL_SetAlpha blobby_SetAlpha
+#define SDL_DisplayFormat blobby_DisplayFormat
+#define SDL_DisplayFormatAlpha blobby_DisplayFormatAlpha
