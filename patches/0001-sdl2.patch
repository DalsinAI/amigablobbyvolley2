+/*=============================================================================
+Blobby Volley 2
+blobby_sdl2.cpp: SDL 1.2's SDL_DisplayFormat() and SDL_DisplayFormatAlpha()
+on SDL 2
+Copyright (C) 2026 AmiCradle Team
+
+This program is free software; you can redistribute it and/or modify
+it under the terms of the GNU General Public License as published by
+the Free Software Foundation; either version 2 of the License, or
+(at your option) any later version.
+
+This program is distributed in the hope that it will be useful,
+but WITHOUT ANY WARRANTY; without even the implied warranty of
+MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+GNU General Public License for more details.
+=============================================================================*/
+
+#include "blobby_sdl2.h"
+
+SDL_Window* blobby_sdl2_window = 0;
+static Uint32 displayFormat = SDL_PIXELFORMAT_ARGB8888;
+
+void blobby_sdl2_set_window(SDL_Window* window)
+{
+	blobby_sdl2_window = window;
+	if (window)
+	{
+		SDL_Surface* screen = SDL_GetWindowSurface(window);
+		if (screen)
+			displayFormat = screen->format->format;
+	}
+}
+
+/* The surface in the display's format; the colour key, the alpha and
+   the blending go with it, as SDL 1.2 kept them */
+SDL_Surface* blobby_DisplayFormat(SDL_Surface* s)
+{
+	if (!s)
+		return 0;
+	SDL_BlendMode blend = SDL_BLENDMODE_NONE;
+	SDL_GetSurfaceBlendMode(s, &blend);
+	SDL_Surface* converted = SDL_ConvertSurfaceFormat(s, displayFormat, 0);
+	if (converted)
+		SDL_SetSurfaceBlendMode(converted, blend);
+	return converted;
+}
+
+/* The surface as 32-bit ARGB: the colour key's pixels see-through, every
+   other pixel as opaque as the surface's alpha (or its own alpha, for a
+   surface that has an alpha channel), blended when drawn: what SDL 1.2's
+   SDL_DisplayFormatAlpha() gave */
+SDL_Surface* blobby_DisplayFormatAlpha(SDL_Surface* s)
+{
+	if (!s)
+		return 0;
+	Uint32 key = 0;
+	bool keyed = SDL_GetColorKey(s, &key) == 0;
+	Uint8 surfaceAlpha = SDL_ALPHA_OPAQUE;
+	SDL_GetSurfaceAlphaMod(s, &surfaceAlpha);
+	bool hasAlpha = s->format->Amask != 0;
+
+	/* the source's own pixels, unblended, as ARGB */
+	SDL_Surface* source = SDL_ConvertSurfaceFormat(s, SDL_PIXELFORMAT_ARGB8888, 0);
+	if (!source)
+		return 0;
+	SDL_SetColorKey(source, SDL_FALSE, 0);
+	SDL_SetSurfaceBlendMode(source, SDL_BLENDMODE_NONE);
+	SDL_SetSurfaceAlphaMod(source, SDL_ALPHA_OPAQUE);
+
+	/* the key, in ARGB, to compare with */
+	Uint32 keyARGB = 0;
+	if (keyed)
+	{
+		Uint8 r, g, b;
+		SDL_GetRGB(key, s->format, &r, &g, &b);
+		keyARGB = (Uint32(r) << 16) | (Uint32(g) << 8) | Uint32(b);
+	}
+
+	if (SDL_MUSTLOCK(source))
+		SDL_LockSurface(source);
+	for (int y = 0; y < source->h; ++y)
+	{
+		Uint32* row = (Uint32*)((Uint8*)source->pixels + y * source->pitch);
+		for (int x = 0; x < source->w; ++x)
+		{
+			Uint32 rgb = row[x] & 0x00FFFFFF;
+			Uint32 alpha = hasAlpha ? (row[x] >> 24) : surfaceAlpha;
+			if (keyed && rgb == keyARGB)
+				alpha = 0;
+			row[x] = (alpha << 24) | rgb;
+		}
+	}
+	if (SDL_MUSTLOCK(source))
+		SDL_UnlockSurface(source);
+	SDL_SetSurfaceBlendMode(source, SDL_BLENDMODE_BLEND);
+	SDL_SetSurfaceRLE(source, 1);
+	return source;
+}
