+=============================================================================*/
+
+/*
+ * Blobby Volley 2 reads its data and writes its settings and replays
+ * through PhysicsFS: a search path of directories and archives, and one
+ * directory written to. The AmigaOS 3.x SDK has no PhysicsFS, and the
+ * game needs only the calls below, so this is them, on directories alone
+ * (no archives: the game data is shipped as its own drawers, not as
+ * .zip files). The names, types and meanings are PhysicsFS 2.0's, for the
+ * calls the game makes; paths are PhysicsFS paths ("gfx/ball01.bmp"),
+ * joined to each directory of the search path (an AmigaOS directory may
+ * end in ':' or '/', as "PROGDIR:" does).
+ */
+
+#pragma once
+
+#include <stddef.h>
+
+typedef unsigned char PHYSFS_uint8;
+typedef signed char PHYSFS_sint8;
+typedef unsigned short PHYSFS_uint16;
+typedef signed short PHYSFS_sint16;
+typedef unsigned int PHYSFS_uint32;
+typedef signed int PHYSFS_sint32;
+typedef unsigned long long PHYSFS_uint64;
+typedef signed long long PHYSFS_sint64;
+
+typedef struct PHYSFS_File
+{
+	void* opaque;
+} PHYSFS_File;
+typedef PHYSFS_File PHYSFS_file;
+
+int PHYSFS_init(const char* argv0);
+int PHYSFS_deinit(void);
+const char* PHYSFS_getLastError(void);
+const char* PHYSFS_getDirSeparator(void);
+const char* PHYSFS_getBaseDir(void);
+const char* PHYSFS_getUserDir(void);
+
+int PHYSFS_addToSearchPath(const char* newDir, int appendToPath);
+int PHYSFS_removeFromSearchPath(const char* oldDir);
+int PHYSFS_setWriteDir(const char* newDir);
+const char* PHYSFS_getWriteDir(void);
+
+PHYSFS_File* PHYSFS_openRead(const char* filename);
+PHYSFS_File* PHYSFS_openWrite(const char* filename);
+int PHYSFS_close(PHYSFS_File* handle);
+PHYSFS_sint64 PHYSFS_read(PHYSFS_File* handle, void* buffer,
+	PHYSFS_uint32 objSize, PHYSFS_uint32 objCount);
+PHYSFS_sint64 PHYSFS_write(PHYSFS_File* handle, const void* buffer,
+	PHYSFS_uint32 objSize, PHYSFS_uint32 objCount);
+PHYSFS_sint64 PHYSFS_fileLength(PHYSFS_File* handle);
+
+int PHYSFS_exists(const char* fname);
+int PHYSFS_isDirectory(const char* fname);
+int PHYSFS_mkdir(const char* dirName);
+int PHYSFS_delete(const char* filename);
+char** PHYSFS_enumerateFiles(const char* dir);
+void PHYSFS_freeList(void* listVar);
diff --git a/src/dirfs/physfs_dirs.cpp b/src/dirfs/physfs_dirs.cpp
