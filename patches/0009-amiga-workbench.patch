 extern "C"
 int main(int argc, char* argv[])
 {
 #if defined(__amigaos__)
+    // AmigaOS, started from its Workbench icon: libnix gives argc 0 and
+    // the WBStartup message in argv, so no program name and no options;
+    // the game then starts as with no options from a Shell (its data and
+    // PROGDIR:User beside the program). Its log and SDL's go to NIL:, so
+    // no console window opens beside the game for them.
+    static char* wbArgv[] = { (char*)"blobby", NULL };
+    if (argc < 1)
+    {
+        argc = 1;
+        argv = wbArgv;
+        freopen("NIL:", "w", stdout);
+        freopen("NIL:", "w", stderr);
+        SDL_LogSetOutputFunction(sdlLogToStderr, NULL);
+    }
