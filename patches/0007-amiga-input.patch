diff --git a/src/InputManager.cpp b/src/InputManager.cpp
index 0b1c0a2..361586e 100644
--- a/src/InputManager.cpp
+++ b/src/InputManager.cpp
@@ -26,6 +26,62 @@ Foundation, Inc., 59 Temple Place, Suite 330, Boston, MA  02111-1307  USA
 
 InputManager* InputManager::mSingleton = 0;
 
+#if defined(__amigaos__)
+#include <cstdio>
+/*
+ * BLOBBY_INPUT (SetEnv BLOBBY_INPUT RAM:input.txt): every key, mouse
+ * button, joystick and pad event the game takes, with its time, for lab
+ * play tests.
+ */
+static void logInput(const SDL_Event& ev)
+{
+	static FILE* f = NULL;
+	static bool tried = false;
+	if (!tried)
+	{
+		const char* fn = SDL_getenv("BLOBBY_INPUT");
+		tried = true;
+		if (fn && fn[0])
+			f = fopen(fn, "a");
+	}
+	if (!f)
+		return;
+	switch (ev.type)
+	{
+		case SDL_KEYDOWN:
+		case SDL_KEYUP:
+			if (ev.key.repeat)
+				return;
+			fprintf(f, "%u key %s %s\n", (unsigned)ev.key.timestamp,
+				SDL_GetKeyName(ev.key.keysym.sym),
+				ev.type == SDL_KEYDOWN ? "down" : "up");
+			break;
+		case SDL_MOUSEBUTTONDOWN:
+		case SDL_MOUSEBUTTONUP:
+			fprintf(f, "%u mouse button %d %s at %d,%d\n",
+				(unsigned)ev.button.timestamp, ev.button.button,
+				ev.type == SDL_MOUSEBUTTONDOWN ? "down" : "up",
+				ev.button.x, ev.button.y);
+			break;
+		case SDL_JOYBUTTONDOWN:
+		case SDL_JOYBUTTONUP:
+			fprintf(f, "%u joy %d button %d %s\n",
+				(unsigned)ev.jbutton.timestamp, (int)ev.jbutton.which,
+				ev.jbutton.button,
+				ev.type == SDL_JOYBUTTONDOWN ? "down" : "up");
+			break;
+		case SDL_JOYAXISMOTION:
+			fprintf(f, "%u joy %d axis %d %d\n",
+				(unsigned)ev.jaxis.timestamp, (int)ev.jaxis.which,
+				ev.jaxis.axis, ev.jaxis.value);
+			break;
+		default:
+			return;
+	}
+	fflush(f);
+}
+#endif
+
